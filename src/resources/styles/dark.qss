/* ============================================================
   ПЕРЕМЕННЫЕ ЦВЕТОВ
   ============================================================ */
@bg-main: #444444;
@bg-dark: #373737;
@bg-darker: #2c2c2c;
@bg-hover: #4a4a4a;
@bg-disabled: #2a2a2a;
@bg-console: #1e1e1e;
@bg-overlay: rgba(0, 0, 0, 180);
@bg-progress: rgba(50, 50, 50, 200);

@text-main: #eaeaea;
@text-light: #ffffff;
@text-meta: #a0a0a0;
@text-muted: #666666;
@text-item: #e0e0e0;
@text-delegate: #CCCCCC;
@text-console: #d4d4d4;
@text-info: rgb(200, 200, 200);

@accent: #018574;
@accent-hover: #02a58a;
@accent-pressed: #00634d;

@border: #808080;
@border-light: #a0a0a0;
@border-item: rgb(60, 60, 60);
@border-muted: rgb(100, 100, 100);

@status-ok: #4ecca3;
@status-error: #ff6b6b;
@status-warning: #f9ca24;

@chart-watched: #2ecc71;
@chart-progress: #f1c40f;
@chart-unwatched: #ff6b6b;

@progress-fill: rgb(76, 175, 80);
@progress-watched: #00634d;
@progress-started: #a77200;
@progress-new: #000000;
@color-inactive: rgba(150, 150, 150, 180);
@separator-color: #555555;

/* Цвета полей ввода (Search, Delay) */
@bg-input: @bg-dark;
@border-input: @border;

/* ============================================================
   ОСНОВНОЕ ОКНО И ВИДЖЕТЫ
   ============================================================ */

QMainWindow {
    background-color: @bg-main;
}

QWidget {
    color: @text-main;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    border-radius: 3px;
}

/* ============================================================
   КНОПКИ
   ============================================================ */

QStatusBar {
    background-color: @bg-dark;
    color: @text-main;
}

QStatusBar QLabel {
    font-size: 11px;
    margin-left: 0px;
}

QPushButton {
    background-color: @bg-dark;
    border: 1px solid @border;
    padding: 6px;
    font-weight: 500;
    min-height: 16px;
}

QPushButton:hover {
    background-color: @accent;
    border-color: @accent;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accent-pressed, stop:1 @accent);
}

QPushButton:disabled {
    background-color: @bg-disabled;
    color: @text-muted;
}

/* Кнопка Play/Pause */
QPushButton#playBtn {
    min-width: 40px;
}

/* Кнопка субтитров и кнопка громкости во включенном (активном) состоянии */
QPushButton#subtitleBtn[active="true"],
QPushButton#volumeBtn[active="true"] {
    background-color: @accent;
    border-color: @accent-hover;
}

QPushButton#subtitleBtn[active="true"]:hover,
QPushButton#volumeBtn[active="true"]:hover {
    background-color: @accent-hover;
    border-color: @accent-hover;
}

QPushButton#subtitleBtn[active="true"]:pressed,
QPushButton#volumeBtn[active="true"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accent-pressed, stop:1 @accent);
    border-color: @accent-pressed;
}

QPushButton#favFilterBtn {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 2px;
}

QPushButton#favFilterBtn:checked {
    background-color: @accent;
    border-color: @accent-hover;
}

QPushButton#favFilterBtn:hover {
    background-color: @bg-hover;
}

QPushButton#favFilterBtn:checked:hover {
    background-color: @accent-hover;
}

QPushButton#tagFilterBtn {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 2px;
}

QPushButton#tagFilterBtn:checked {
    background-color: @accent;
    border-color: @accent-hover;
}

QPushButton#tagFilterBtn:hover {
    background-color: @bg-hover;
}

QPushButton#tagFilterBtn:checked:hover {
    background-color: @accent-hover;
}

QPushButton#markerToggleBtn {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 2px;
}

QPushButton#markerToggleBtn:checked {
    background-color: @accent;
    border-color: @accent-hover;
}

QPushButton#markerToggleBtn:hover {
    background-color: @bg-hover;
}

QPushButton#markerToggleBtn:checked:hover {
    background-color: @accent-hover;
}

/* Аудио-фильтры на панели */
QPushButton#audioFilterBtn {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 2px;
    padding: 2px;
    font-size: 11px;
}

QPushButton#audioFilterBtn:hover {
    background-color: @accent-hover;
    border-color: @border-light;
}

QPushButton#audioFilterBtn:checked,
QPushButton#audioFilterBtn[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accent-pressed, stop:1 @accent);
    border: 1px solid @accent;
    color: @text-light;
}

#delaySmallBtn {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 2px;
    font-weight: bold;
    font-size: 14px;
    color: @text-light;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    margin: 0;
}

#delaySmallBtn:hover {
    background-color: @accent-hover;
    border-color: @border-light;
    color: #ffffff;
}

#delaySmallBtn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accent-pressed, stop:1 @accent);
    border-color: @accent;
}

#delaySpin {
    background-color: @bg-input;
    border: 1px solid @border-input;
    border-radius: 2px;
    color: @text-item;
    font-family: 'Consolas', monospace;
    font-size: 11px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    margin: 0;
}

QPushButton#audioFilterBtn:hover {
    background-color: @bg-hover;
    border-color: @border-light;
}

/* ============================================================
   ПОЛЯ ВВОДА
   ============================================================ */

QLineEdit {
    background-color: @bg-input;
    border: 1px solid @border-input;
    padding: 6px;
    min-height: 16px;
    color: @text-main;
    selection-background-color: @accent;
}

QLineEdit:focus {
    border-color: @accent;
    background-color: @bg-dark;
}

QLineEdit:hover {
    border-color: @border-light;
}

QLineEdit::placeholder {
    color: @text-muted;
}

/* ============================================================
   СПИСКИ
   ============================================================ */

QListWidget {
    background-color: @bg-main;
    border: 1px solid @border;
    /*padding: 5px;*/
    outline: none;
    /* Отключаем стандартную рамку фокуса */
    show-decoration-selected: 1;
}

/* Убираем пунктирную рамку фокуса */
QListWidget:focus {
    outline: none;
    border: 1px solid @accent;  /* Опционально: подсветка границы */
}

QListWidget::item {
    /*padding: 5px;*/
    border: none;
}

/* --- Обычное состояние --- */
QListWidget::item {
    background-color: transparent;
    color: @text-item;
}

/* --- Наведение --- */
QListWidget::item:hover {
    background-color: @bg-hover;
    color: @text-light;
}

/* --- Выделение С фокусом --- */
QListWidget::item:selected:active {
    background-color: @accent;
    color: @text-light;
}

/* --- Выделение БЕЗ фокуса (КЛЮЧЕВОЕ!) --- */
QListWidget::item:selected:!active {
    background-color: @accent;  /* Сохраняем тот же цвет */
}

/* --- Наведение на выделенный С фокусом --- */
QListWidget::item:selected:active:hover {
    background-color: @accent-hover;
    color: @text-light;
}

/* --- Наведение на выделенный БЕЗ фокуса --- */
QListWidget::item:selected:!active:hover {
    background-color: @accent-hover;
    color: @text-light;
}

/* --- Отключённый элемент --- */
QListWidget::item:disabled {
    background-color: transparent;
    color: @text-muted;
}

/* ============================================================
   ДЕРЕВЬЯ
   ============================================================ */

/* QTreeWidget — выделение сохраняется при потере фокуса */
QTreeWidget {
    background-color: @bg-main;
    border: 1px solid @border;
    /*padding: 5px;*/
    outline: none;
    show-decoration-selected: 1;
    border-radius: 3px;
}

/* Исключаем скругление для дерева видеокурсов */
HoverTreeWidget {
    border-radius: 0px;
    outline: none;
    show-decoration-selected: 0;
}

/* Нормальное состояние */
QTreeWidget::item {
    /*padding: 5px;*/
    background-color: transparent;
    color: @text-item;
}

/* Hover */
QTreeWidget::item:hover {
    background-color: @bg-hover;
    color: @text-light;
}

/* СИСТЕМНОЕ выделение АКТИВНОЕ (есть фокус) */
QTreeWidget::item:selected:active {
    background-color: @accent;
    color: @text-light;
}

/* СИСТЕМНОЕ выделение НЕАКТИВНОЕ (потерян фокус) — ТОТ ЖЕ ЦВET */
QTreeWidget::item:selected:!active {
    background-color: @accent;
}

/* Программное выделение (текущая книга) — приоритет */
QTreeWidget::item[playing="true"] {
    background-color: @accent !important;
    color: @text-light !important;
}

/* Убираем выделение и подсветку при наведении для элементов библиотеки (HoverTreeWidget) */
HoverTreeWidget::item:selected:active {
    background-color: transparent;
    color: @text-item;
    border: none;
}

HoverTreeWidget::item:selected:!active {
    background-color: transparent;
    color: @text-item;
    border: none;
}

HoverTreeWidget::item:hover {
    background-color: transparent;
    color: @text-item;
}

HoverTreeWidget::item:selected:hover {
    background-color: transparent;
    color: @text-item;
}


/* ============================================================
   СЛАЙДЕРЫ
   ============================================================ */

QSlider::groove:horizontal {
    background: @border;
    height: 10px;
}

QSlider::handle:horizontal {
    background: @accent;
    width: 14px;
    margin: -5px 0;
    border: 2px solid @bg-dark;
}

QSlider::handle:horizontal:hover {
    background: @accent-hover;
}

QSlider::handle:horizontal:pressed {
    background: @accent-pressed;
}

QSlider::sub-page:horizontal {
    background-color: @accent;
}

QSlider::add-page:horizontal {
    background: @border;
}

QSlider#speedSlider::sub-page:horizontal {
    background-color: @border;
}

/* ============================================================
   ПРОГРЕСС-БАРЫ
   ============================================================ */

QProgressBar {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 3px;
    text-align: center;
    color: @text-light;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: @accent;
}

#scanProgressBar {
    height: 25px;
    font-size: 13px;
}

#scanConsole {
    background-color: @bg-console;
    color: @text-console;
    font-family: Consolas, monospace;
    font-size: 11px;
    border: 1px solid @bg-main;
}

#scanStatusLabel {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 5px;
}

/* ============================================================
   МЕТКИ (LABELS)
   ============================================================ */

QLabel {
    color: @text-main;
}



QLabel#titleLabel {
    font-size: 18px;
    font-weight: bold;
    color: @text-light;
}

QLabel#subtitleLabel {
    font-size: 14px;
    color: @text-meta;
}

QLabel#popupHeaderLabel {
    font-size: 12px;
    font-weight: bold;
    color: @text-meta;
    margin-bottom: 2px;
    qproperty-alignment: AlignCenter;
}

QLabel#timeLabel {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px;
    color: @text-meta;
}

QLabel#bigTimeLabel {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 15px;
    font-weight: bold;
    color: @accent;
}

QLabel#statusOk {
    color: @status-ok;
    font-weight: bold;
}

QLabel#statusError {
    color: @status-error;
    font-weight: bold;
}

QLabel#statusWarning {
    color: @status-warning;
    font-weight: bold;
}

QLabel#sectionLabel {
    font-weight: bold;
    color: @text-light;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ============================================================
   СКРОЛЛБАРЫ
   ============================================================ */

/* Вертикальный скроллбар */
QScrollBar:vertical {
    background-color: @bg-main;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: @border;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: @accent;
}

QScrollBar::handle:vertical:pressed {
    background-color: @accent-hover;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* Горизонтальный скроллбар */
QScrollBar:horizontal {
    background-color: @bg-main;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: @border;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @accent;
}

QScrollBar::handle:horizontal:pressed {
    background-color: @accent-hover;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============================================================
   ФРЕЙМЫ
   ============================================================ */

QFrame {
    border: none;
}

QFrame#separator {
    background-color: @border;
    max-height: 2px;
    min-height: 2px;
}

/* ============================================================
   МЕНЮ
   ============================================================ */
/* Цвет верхней панели (меню-бар) */
QMenuBar {
    background-color: @bg-dark;  /* основной фон панели */
    color: @text-main;             /* цвет текста пунктов меню */
    font-size: 13px;
}

QMenu {
    background-color: @bg-dark;
    border: 1px solid @bg-main;
    padding: 2px;
    margin: 3px;
}

QMenu::item {
    padding: 2px 2px;
    color: @text-main;

}

QMenu::item:selected {
    background-color: @accent;
    color: @text-light;

}

QMenu::item:pressed {
    background-color: @accent-pressed;

}

QMenu::separator {
    height: 1px;
    background-color: @border;
    margin: 5px 10px;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

/* ============================================================
   ОКНО НАСТРОЕК
   ============================================================ */
/* Фон диалогового окна */
QDialog {
    background-color: @bg-main;  /* тёмно-серый фон */
    color: @text-main;             /* цвет текста внутри диалога */
}

/* Фон всего виджета вкладок */
QTabWidget {
    background-color: @bg-dark; /* фон контента вкладки */
}

/* Вкладки сверху */
QTabBar {
    background-color: @bg-darker; /* фон полоски с вкладками */
}

QTabBar::tab {
    background-color: @bg-main;  /* фон вкладки */
    color: @text-main;             /* цвет текста */
    padding: 8px 20px;
    border: 1px solid @border;  /* рамка вокруг вкладки */
    border-bottom: none;         /* чтобы была "связанная" с контентом */
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    margin-right: 2px;
}

/* Вкладка при наведении мыши */
QTabBar::tab:hover {
    background-color: @accent;
    color: @text-light;
}

/* Активная вкладка */
QTabBar::tab:selected {
    background-color: @accent;
    color: @text-light;
    border-bottom: 1px solid @accent; /* чтобы визуально сливалась с контентом */
}

/* Вкладки слева/справа/снизу — если используешь */
QTabBar::tab:!selected {
    margin-top: 2px;  /* отделяем неактивные от активной */
}

/* ========================================
   ДЕЛЕГАТ АУДИОКНИГИ - СТИЛИЗАЦИЯ СТРОК
   ======================================== */

/* Автор книги */
QLabel#delegate_author {
    font-size: 14px;
    color: @text-delegate;
}

/* Название книги */
QLabel#delegate_title {
    font-size: 14px;
    font-weight: bold;
    color: @text-delegate;
}

/* Рассказчик */
QLabel#delegate_narrator {
    font-size: 14px;
    color: @text-delegate;
}

/* Общая информация */
QLabel#delegate_info {
    font-size: 14px;
    font-weight: bold;
    color: @text-delegate;
}

/* Папка */
QLabel#delegate_folder {
    font-size: 14px;
    font-weight: bold;
    color: @text-delegate;
}

/* Прогресс прослушивания */
QLabel#delegate_progress {
    font-size: 12px;
    font-weight: bold;
    color: @text-delegate;
}

/* Длительность */
QLabel#delegate_duration {
    font-size: 12px;
    font-weight: bold;
    color: @text-delegate;
}

/* Количество файлов */
QLabel#delegate_file_count {
    font-size: 12px;
    font-weight: bold;
    color: @text-delegate;
}

/* ============================================================
   TOOLTIP (всплывающие подсказки)
   ============================================================ */

QToolTip {
    color: @text-main;              /* цвет текста */
    border: 1px solid @accent;  /* рамка */
    padding: 3px;
}

/* ============================================================
   TREE
   ============================================================ */

/* Рамка миниатюры */
#thumbnail_border {
    border: 1px solid @border-item;
}

/* Фон прогресс-бара */
#progress_bar_bg {
    background-color: @bg-progress;
    min-height: 5px;
    max-height: 5px;
}

/* Заполнение прогресс-бара */
#progress_bar_fill {
    background-color: @progress-fill;
}

/* Активная точка индикатора */
#dot_active {
    background-color: @text-light;
    min-width: 6px;
    max-width: 6px;
    min-height: 6px;
    max-height: 6px;
}

/* Неактивная точка индикатора */
#dot_inactive {
    background-color: @color-inactive;
}

/* Фон пустой миниатюры */
#empty_thumbnail_bg {
    background-color: @border-item;
}

/* Рамка пустой миниатюры */
#empty_thumbnail_border {
    border: 1px solid @border-muted;
}

/* Иконка пустой миниатюры */
#empty_thumbnail_icon {
    color: @color-inactive;
    font-family: Arial;
    font-size: 16pt;
}

/* Фон метки длительности */
#duration_label_bg {
    background-color: @bg-overlay;
}

/* Текст метки длительности */
#duration_label_text {
    color: white;
    font-size: 9pt;
}

/* Метки прогресса для VideoItemDelegate */
#duration_label_watched {
    background-color: @progress-watched;
}

#duration_label_started {
    background-color: @progress-started;
}

#duration_label_new {
    background-color: @progress-new;
}

/* Название видео */
#video_title {
    color: white;
    font-size: 12px;
    font-weight: bold;
}

/* Информация о видео */
#video_info {
    color: @text-info;
    font-size: 12px;
}

/* Текст прогресса просмотра */
#video_progress_text {
    color: @progress-fill;
    font-size: 12px;
    /*font-style: italic;*/
}

/* Кнопка Play/Pause на обложке видео в библиотеке */
#row_play_button_bg {
    background-color: @accent;
}

#row_play_button_icon {
    color: @text-main;
}

/* ============================================================
   QComboBox в стиле кнопок
   ============================================================ */

QComboBox {
    background-color: @bg-dark;
    color: @text-main;
    border: 1px solid @border;
    padding: 5px;
    min-height: 16px;
    font-weight: 500;
}

QComboBox:hover {
    background-color: @accent;
    border-color: @accent;
}

QComboBox:focus {
    border-color: @accent;
}

/* убираем зону стрелки */
QComboBox::drop-down {
    width: 0px;
    border: none;
}

/* Выпадающий список */
QComboBox QAbstractItemView {
    background-color: @bg-dark;
}



/* ============================================================
   GROUP BOX
   ============================================================ */

QGroupBox {
    background-color: transparent;
    border: 1px solid @border;
    border-radius: 5px;
    margin-top: 15px; /* Leave space for the title */
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 3px;
    background-color: @bg-main; /* Should match the dialog background */
    color: @text-main;
}

/* ============================================================
   FOLDER STATS DIALOG
   ============================================================ */

QDialog#FolderStatsDialog {
    background-color: @bg-main;
}

#FolderStatsDialog QLabel {
    font-family: 'Segoe UI', Arial, sans-serif;
}


/* ============================================================
   PICTURE-IN-PICTURE (PIP)
   ============================================================ */

#pipCloseBtn {
    background-color: rgba(0, 0, 0, 150);
    color: white;
    border: none;
    font-weight: bold;
    border-radius: 0px;
}

#pipCloseBtn:hover {
    background-color: rgba(255, 0, 0, 200);
}

/* ============================================================
   MARKER DIALOG
   ============================================================ */

.MarkerColorBtn {
    border: 1px solid #808080;
    border-radius: 3px;
}

.MarkerColorBtn[selected="true"] {
    border: 2px solid white;
}

/* ============================================================
   MARKER GALLERY
   ============================================================ */

MarkerItem {
    background-color: rgba(42, 42, 42, 180);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 30);
}

MarkerItem:hover {
    background-color: rgba(60, 60, 60, 220);
    border: 1px solid rgba(255, 255, 255, 80);
}

#markerThumb {
    background-color: #000000;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 4px;
}

#markerTimeLabel {
    background-color: rgba(0, 0, 0, 180);
    color: #ffffff;
    border-radius: 3px;
    padding: 1px 4px;
    font-size: 10px;
    font-weight: bold;
}

#markerTitleLabel {
    background-color: rgba(30, 30, 30, 200);
    color: #eaeaea;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
}

MarkerGalleryWidget {
    background-color: rgba(10, 10, 10, 150);
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 10px;
}

#markerGalleryScroll, #markerGalleryContent {
    background: transparent;
    border: none;
}

#noMarkersLabel {
    background-color: rgba(0, 0, 0, 100);
    color: #aaaaaa;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 13px;
    border: 1px solid rgba(255, 255, 255, 20);
}

/* ============================================================
   PREVIEW POPUP
   ============================================================ */

PreviewPopup {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 6px;
    color: #ffffff;
}

PreviewPopup QLabel {
    border: none;
    background-color: transparent;
}

#subtitleLabel {
    color: #aaa;
    font-size: 10px;
}

#volumePercentLabel {
    color: #eaeaea;
    font-size: 12px;
}

#previewThumb {
    background-color: #000000;
    border-radius: 4px;
}

#previewTimeLabel {
    background-color: #444444; 
    color: #eaeaea;
    border-radius: 3px; 
    padding: 2px 6px; 
    font-weight: bold; 
    font-size: 12px;
}

/* ============================================================
   SETTINGS DIALOG
   ============================================================ */

#clearDataBtn {
    background-color: #8B0000;
    color: white;
    font-weight: bold;
}

#clearDataBtn:hover {
    background-color: #a00000;
}

/* ============================================================
   SUBTITLE & VOLUME POPUPS
   ============================================================ */

#subtitlePopup, #volumePopup, #tagFilterPopup {
    background-color: #444444;
    border: 1px solid @border;
    border-radius: 3px;
}

#interactiveSubtitlesBtn {
    background-color: #373737;
    border: 1px solid #808080;
    border-radius: 3px;
}

#interactiveSubtitlesBtn:hover {
    background-color: @accent;
    border-color: @accent;
}

#interactiveSubtitlesBtn:checked {
    background-color: @accent;
    border-color: @accent;
}

#subtitleList, #audioList, #tagFilterList {
    background-color: #3a3a3a;
    border: none;
    outline: none;
}

#subtitleList::item, #audioList::item {
    padding: 6px 10px;
    color: #eaeaea;
    border-bottom: 1px solid #484848;
}

#subtitleList::item:hover, #audioList::item:hover {
    background-color: #505050;
}

#subtitleList::item:selected, #audioList::item:selected {
    background-color: @accent;
}

#textColorBtn, #secondaryTextColorBtn, #outlineColorBtn {
    border: 1px solid #808080;
    border-radius: 3px;
    padding: 0px;
    margin: 0px;
    min-width: 64px;
    min-height: 30px;
}

#popupSubtitleToggle {
    background-color: #373737;
    border: 1px solid #808080;
    border-radius: 3px;
}

#popupSubtitleToggle:hover {
    background-color: @accent;
    border-color: @accent;
}

QPushButton#translationLangBtn {
    background-color: @bg-dark;
    color: @text-main;
    border: 1px solid @border;
    border-radius: 3px;
    font-weight: 500;
    font-size: 11px;
    padding: 4px;
}

QPushButton#translationLangBtn:hover {
    background-color: @accent;
    border-color: @accent;
    color: @text-light;
}

/* Language Selection Dialog */
QDialog#languageSelectDialog {
    background-color: @bg-darker;
    border: 1px solid @border;
    border-radius: 3px;
}

QLineEdit#langSearchInput {
    background-color: @bg-console;
    color: @text-main;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 4px;
    font-size: 11px;
}

QLineEdit#langSearchInput:focus {
    border-color: @accent;
}

QListWidget#langSearchList {
    background-color: transparent;
    border: none;
    color: @text-main;
    font-size: 11px;
}

QListWidget#langSearchList::item {
    padding: 4px;
    border-radius: 2px;
}

QListWidget#langSearchList::item:hover {
    background-color: @bg-hover;
    color: @text-light;
}

QListWidget#langSearchList::item:selected {
    background-color: @accent;
    color: @text-light;
}

#volumeSlider::groove:vertical {
    background: #808080;
    width: 11px;
}

#volumeSlider::handle:vertical {
    background: @accent;
    width: 16px;
    height: 16px;
    margin: 0 -4px;
    border: 2px solid #373737;
}

#volumeSlider::handle:vertical:hover {
    background: @accent-hover;
}

#volumeSlider::handle:vertical:pressed {
    background: @accent-pressed;
}

#volumeSlider::sub-page:vertical {
    background: #808080;
}

#volumeSlider::add-page:vertical {
    background: @accent;
}

/* Dynamic volume levels */
#volumeSlider[level="warning"]::add-page:vertical {
    background: @status-warning;
}

#volumeSlider[level="danger"]::add-page:vertical {
    background: @status-error;
}

/* ============================================================
   TAGS DIALOG
   ============================================================ */

#TagColorBtn {
    border-radius: 3px;
    border: 1px solid #808080;
}

#TagBadge {
    border-radius: 3px;
    padding: 2px 5px;
    font-size: 12px;
    color: white;
}

#colorPalette {
    background-color: #444;
    border: 1px solid #555;
    padding: 5px;
    border-radius: 3px;
}

/* Cards/Containers */
#FolderStatsDialog QFrame {
    background-color: @bg-dark;
    border-radius: 5px;
}

/* Specific Labels */
#FolderStatsDialog QLabel#StatsTitle {
    font-size: 18px; 
    font-weight: bold; 
    color: @text-light;
}

#FolderStatsDialog QLabel#StatsSubtitle {
    font-size: 13px; 
    color: @text-meta;
}

#FolderStatsDialog QLabel#StatsLabel {
    font-size: 13px; 
    color: @text-meta;
}

#FolderStatsDialog QLabel#StatsValue {
    font-size: 13px; 
    font-weight: bold; 
    color: @text-main;
}

/* Legend */
#FolderStatsDialog QLabel#LegendLabel {
    color: @text-meta; 
    font-size: 11px;
}

/* Progress Bar */
#FolderStatsDialog QProgressBar#FolderStatsProgressBar {
    border: none;
    background-color: @bg-main;
    border-radius: 5px;
    text-align: center;
}

#FolderStatsDialog QProgressBar#FolderStatsProgressBar::chunk {
    background-color: @accent;
    border-radius: 5px;
}

/* Header Labels */
#FolderStatsDialog QLabel#ProgressLabel {
    font-weight: bold;
    font-size: 14px;
    color: @text-main;
}

/* Vertical Separator Line */
#FolderStatsDialog QFrame#StatsSeparator {
    background-color: @separator-color;
}

/* Legend Dot */
#FolderStatsDialog QLabel#LegendDot {
    font-size: 16px;
}

/* Status Properties for Coloring */
QLabel[status="watched"] { color: @chart-watched; }
QLabel[status="in_progress"] { color: @chart-progress; }
QLabel[status="unwatched"] { color: @chart-unwatched; }
QLabel[status="default"] { color: @text-main; }

/* Donut Chart Colors */
DonutChart {
    qproperty-watchedColor: @chart-watched;
    qproperty-inProgressColor: @chart-progress;
    qproperty-unwatchedColor: @chart-unwatched;
    qproperty-holeColor: @bg-dark;     /* Matches card background */
    qproperty-centerTextColor: @text-light;
}


/* ============================================================
   CHECKBOXES (QTreeWidget indicators)
   ============================================================ */

QTreeWidget::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #cccccc;
    border-radius: 2px;
}

QTreeWidget::indicator:checked {
    image: none;
    border: 1px solid #cccccc;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.4, fx:0.5, fy:0.5, stop:0 #cccccc, stop:0.6 #cccccc, stop:0.7 transparent);
}


QTreeWidget::indicator:unchecked {
    background-color: transparent;
}


/* ============================================================
   CHECKBOXES (QCheckBox indicators)
   ============================================================ */

QCheckBox::indicator, QListWidget::indicator, QTreeWidget::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #cccccc;
    border-radius: 2px;
}

QCheckBox::indicator:checked, QListWidget::indicator:checked, QTreeWidget::indicator:checked {
    image: none;
    border: 1px solid #cccccc;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.4, fx:0.5, fy:0.5, stop:0 #cccccc, stop:0.6 #cccccc, stop:0.7 transparent);
}

QCheckBox::indicator:unchecked, QListWidget::indicator:unchecked, QTreeWidget::indicator:unchecked {
    background-color: transparent;
}


/* ============================================================
   TAGS DIALOG
   ============================================================ */

QPushButton#TagColorBtn {
    border: 1px solid #555555;
    border-radius: 4px;
}

QLabel#TagBadge {
    padding: 3px 8px;
    border-radius: 10px;
    color: #ffffff;
    font-weight: bold;
}

/* ============================================================
   TAG FILTER POPUP
   ============================================================ */
#TagPopupFrame {
    background-color: @bg-dark;
    border: 1px solid @accent;
    border-radius: 5px;
}

#popupTagList {
    background-color: transparent;
    border: none;
}

#popupSeparator {
    background-color: @border;
    max-height: 1px;
    min-height: 1px;
}

#TagPopupFrame QPushButton {
    background-color: @bg-darker;
    border: 1px solid @border;
    font-size: 11px;
    padding: 4px;
}

#TagPopupFrame QPushButton:hover {
    background-color: @accent;
}

/* ============================================================
   ABOUT DIALOG
   ============================================================ */

#aboutContainer {
    background-color: @bg-darker;
    border: 1px solid @bg-main;
    border-radius: 3px;
    padding: 40px 30px 30px 30px;
    min-width: 780px;
}

#aboutContainer QLabel {
    color: @text-delegate;
}

#aboutTitle { 
    font-size: 24px; 
    font-weight: bold; 
}

#aboutVersion { 
    color: @text-delegate; 
    font-size: 12px;
    line-height: 16px;
}

QLabel#aboutGithubLink {
    color: @accent;
    font-weight: bold;
    font-size: 13px;
    line-height: 16px;
    text-decoration: none;
}

QLabel#aboutGithubLink:hover {
    color: white;
}

#aboutSeparator {
    background-color: @separator-color;
}

#aboutDescription { 
    font-size: 13px;
}

#aboutHotkeyTitle { 
    font-weight: bold; 
    font-size: 14px;
    margin-top: 10px;
    margin-bottom: 5px;
}

#hotkeyCategoryTitle {
    font-weight: bold;
    font-size: 13px;
    padding-top: 8px;
    padding-bottom: 4px;
}

#hotkeyCategorySeparator {
    background-color: @separator-color;
    max-height: 1px;
    margin-top: 4px;
    margin-bottom: 8px;
}

#hotkeyWidget {
    background-color: transparent;
}

#hotkeyKey {
    background-color: @bg-darker;
    border: 1px solid @separator-color;
    border-bottom: 2px solid #1a1a1a;
    border-radius: 4px;
    padding: 2px 6px;
    font-weight: bold;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 11px;
    min-width: 40px;
}

#hotkeyDesc { 
    font-size: 11px;
}

#aboutSectionContent {
    font-size: 12px;
}

#aboutHotkeyScroll QScrollBar:vertical {
    width: 8px;
    background: transparent;
}

#aboutHotkeyScroll QScrollBar::handle:vertical {
    background: @separator-color;
    border-radius: 4px;
}

#aboutCloseBtn { 
    background-color: @bg-main; 
    color: @text-delegate; 
    border: none; 
    border-radius: 3px; 
    padding: 8px 20px; 
    font-weight: bold;
    font-size: 13px;
}

#aboutCloseBtn:hover { 
    background-color: @bg-hover; 
}

#aboutCloseBtn:pressed { 
    background-color: @bg-dark; 
}

/* ============================================================
   TRANSLATION POPUP AND DICTIONARY BUTTON
   ============================================================ */
#TranslationPopup QLabel {
    background: transparent;
    border: none;
}



QPushButton#dictBtn[added="true"] {
    background-color: @accent;
    border-color: @accent-hover;
}

QPushButton#dictBtn[added="true"]:hover {
    background-color: @accent-hover;
}

QPushButton#dictBtn[added="true"]:pressed {
    background-color: @accent-pressed;
}

/* Subtitle overlay translate entire subtitle button */
QPushButton#translateSubBtn, QPushButton#prevPhraseBtn, QPushButton#nextPhraseBtn, QPushButton#replayPhraseBtn {
    background-color: rgba(255, 255, 255, 20);
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 3px;
    padding: 0px;
}

QPushButton#translateSubBtn:hover, QPushButton#prevPhraseBtn:hover, QPushButton#nextPhraseBtn:hover, QPushButton#replayPhraseBtn:hover {
    background-color: @accent;
    border-color: @accent;
}

QPushButton#translateSubBtn:pressed, QPushButton#prevPhraseBtn:pressed, QPushButton#nextPhraseBtn:pressed, QPushButton#replayPhraseBtn:pressed {
    background-color: @accent-pressed;
    border-color: @accent-pressed;
}

#translationPopupOriginalLabel {
    color: rgba(255, 255, 255, 180);
    font-size: 10pt;
    font-weight: 500;
    font-family: "Segoe UI";
}

#translationPopupTranslationLabel {
    color: #FFD700;
    font-size: 12pt;
    font-weight: bold;
    font-family: "Segoe UI";
}

/* ============================================================
   REFACTORED INLINE STYLES ENFORCEMENT
   ============================================================ */

#subtitleTextEdit {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

#SubtitleOverlayWidget {
    background: transparent;
    border: none;
}

QSplitter#settingsSplitter::handle {
    margin: 0 3px;
}

#purerefPathStatus[status="valid"] {
    color: #4CAF50;
}

#purerefPathStatus[status="invalid"] {
    color: #F44336;
}

QWidget#colorPickerContainer {
    background-color: #2D2D2D;
    border: 1px solid #444444;
    border-radius: 4px;
}

QPushButton.colorCell {
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 0px;
    background-color: transparent;
    padding: 0px;
}

QPushButton.colorCell:hover {
    border: 1px solid white;
}

QListWidget#tagsList {
    padding: 5px;
    border: 1px solid #555555;
    outline: none;
}

QListWidget#tagsList:focus {
    border: 1px solid #555555;
}

#colorPalette QPushButton {
    background-color: transparent;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 0px;
    padding: 0px;
}

#colorPalette QPushButton:hover {
    border: 1px solid white;
}

.MarkerColorBtn {
    background-color: transparent;
    padding: 0px;
}

QLabel#markerTitleLabel {
    border: 1px solid #FFD700;
}

QLabel#markerTitleLabel[marker_color="#FFD700"] { border: 1px solid #FFD700; }
QLabel#markerTitleLabel[marker_color="#FF4136"] { border: 1px solid #FF4136; }
QLabel#markerTitleLabel[marker_color="#2ECC40"] { border: 1px solid #2ECC40; }
QLabel#markerTitleLabel[marker_color="#0074D9"] { border: 1px solid #0074D9; }
QLabel#markerTitleLabel[marker_color="#B10DC9"] { border: 1px solid #B10DC9; }
QLabel#markerTitleLabel[marker_color="#FF851B"] { border: 1px solid #FF851B; }
QLabel#markerTitleLabel[marker_color="#7FDBFF"] { border: 1px solid #7FDBFF; }
QLabel#markerTitleLabel[marker_color="#F012BE"] { border: 1px solid #F012BE; }
QLabel#markerTitleLabel[marker_color="#01FF70"] { border: 1px solid #01FF70; }
QLabel#markerTitleLabel[marker_color="#39CCCC"] { border: 1px solid #39CCCC; }
QLabel#markerTitleLabel[marker_color="#85144B"] { border: 1px solid #85144B; }
QLabel#markerTitleLabel[marker_color="#AAAAAA"] { border: 1px solid #AAAAAA; }

QLabel#updateDialogTitle {
    font-size: 12pt;
    font-weight: bold;
}

QLabel#updateDialogNewVersion {
    font-weight: bold;
}

/* ============================================================
   СЕГМЕНТИРОВАННЫЕ КНОПКИ СУБТИТРОВ И ГРОМКОСТИ
   ============================================================ */
QPushButton#subtitleBtn, QPushButton#volumeBtn, QPushButton#tagFilterBtn {
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    border-right: none;
}

QPushButton#subSettingsBtn, QPushButton#volSettingsBtn, QPushButton#tagFilterSettingsBtn {
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    padding: 0px;
}
