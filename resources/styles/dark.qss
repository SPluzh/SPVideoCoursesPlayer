/* ============================================================
   ПЕРЕМЕННЫЕ ЦВЕТОВ
   ============================================================ */
@bg-main: #444444;
@bg-dark: #373737;
@bg-darker: #2c2c2c;
@bg-hover: #4a4a4a;
@bg-disabled: #2a2a2a;
@bg-console: #1e1e1e;
@bg-overlay: rgba(0, 0, 0, 180);
@bg-progress: rgba(50, 50, 50, 200);

@text-main: #eaeaea;
@text-light: #ffffff;
@text-meta: #a0a0a0;
@text-muted: #666666;
@text-item: #e0e0e0;
@text-delegate: #CCCCCC;
@text-console: #d4d4d4;
@text-info: rgb(200, 200, 200);

@accent: #018574;
@accent-hover: #02a58a;
@accent-pressed: #00634d;

@border: #808080;
@border-light: #a0a0a0;
@border-item: rgb(60, 60, 60);
@border-muted: rgb(100, 100, 100);

@status-ok: #4ecca3;
@status-error: #ff6b6b;
@status-warning: #f9ca24;

@chart-watched: #2ecc71;
@chart-progress: #f1c40f;
@chart-unwatched: #ff6b6b;

@progress-fill: rgb(76, 175, 80);
@color-inactive: rgba(150, 150, 150, 180);
@separator-color: #555555;

/* ============================================================
   ОСНОВНОЕ ОКНО И ВИДЖЕТЫ
   ============================================================ */

QMainWindow {
    background-color: @bg-main;
}

QWidget {
    color: @text-main;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    border-radius: 3px;
}

/* ============================================================
   КНОПКИ
   ============================================================ */

QStatusBar {
    background-color: @bg-dark;
    color: @text-main;
}

QStatusBar QLabel {
    font-size: 11px;
    margin-left: 0px;
}

QPushButton {
    background-color: @bg-dark;
    border: 1px solid @border;
    padding: 6px;
    font-weight: 500;
    min-height: 16px;
}

QPushButton:hover {
    background-color: @accent;
    border-color: @accent;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accent-pressed, stop:1 @accent);
}

QPushButton:disabled {
    background-color: @bg-disabled;
    color: @text-muted;
}

/* Кнопка Play/Pause */
QPushButton#playBtn {
    min-width: 50px;
}

QPushButton#favFilterBtn {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 2px;
}

QPushButton#favFilterBtn:checked {
    background-color: @accent;
    border-color: @accent-hover;
}

QPushButton#favFilterBtn:hover {
    background-color: @bg-hover;
}

QPushButton#favFilterBtn:checked:hover {
    background-color: @accent-hover;
}

QPushButton#tagFilterBtn {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 2px;
}

QPushButton#tagFilterBtn:checked {
    background-color: @accent;
    border-color: @accent-hover;
}

QPushButton#tagFilterBtn:hover {
    background-color: @bg-hover;
}

QPushButton#tagFilterBtn:checked:hover {
    background-color: @accent-hover;
}

/* ============================================================
   ПОЛЯ ВВОДА
   ============================================================ */

QLineEdit {
    background-color: @bg-dark;
    border: 1px solid @border;
    padding: 6px;
    min-height: 16px;
    color: @text-main;
    selection-background-color: @accent;
}

QLineEdit:focus {
    border-color: @accent;
    background-color: @bg-dark;
}

QLineEdit:hover {
    border-color: @border-light;
}

QLineEdit::placeholder {
    color: @text-muted;
}

/* ============================================================
   СПИСКИ
   ============================================================ */

QListWidget {
    background-color: @bg-main;
    border: 1px solid @border;
    /*padding: 5px;*/
    outline: none;
    /* Отключаем стандартную рамку фокуса */
    show-decoration-selected: 1;
}

/* Убираем пунктирную рамку фокуса */
QListWidget:focus {
    outline: none;
    border: 1px solid @accent;  /* Опционально: подсветка границы */
}

QListWidget::item {
    /*padding: 5px;*/
    border: none;
}

/* --- Обычное состояние --- */
QListWidget::item {
    background-color: transparent;
    color: @text-item;
}

/* --- Наведение --- */
QListWidget::item:hover {
    background-color: @bg-hover;
    color: @text-light;
}

/* --- Выделение С фокусом --- */
QListWidget::item:selected:active {
    background-color: @accent;
    color: @text-light;
}

/* --- Выделение БЕЗ фокуса (КЛЮЧЕВОЕ!) --- */
QListWidget::item:selected:!active {
    background-color: @accent;  /* Сохраняем тот же цвет */
}

/* --- Наведение на выделенный С фокусом --- */
QListWidget::item:selected:active:hover {
    background-color: @accent-hover;
    color: @text-light;
}

/* --- Наведение на выделенный БЕЗ фокуса --- */
QListWidget::item:selected:!active:hover {
    background-color: @accent-hover;
    color: @text-light;
}

/* --- Отключённый элемент --- */
QListWidget::item:disabled {
    background-color: transparent;
    color: @text-muted;
}

/* ============================================================
   ДЕРЕВЬЯ
   ============================================================ */

/* QTreeWidget — выделение сохраняется при потере фокуса */
QTreeWidget {
    background-color: @bg-main;
    border: 1px solid @border;
    /*padding: 5px;*/
    outline: none;
    show-decoration-selected: 1;
    border-radius: 3px;
}

/* Исключаем скругление для дерева видеокурсов */
HoverTreeWidget {
    border-radius: 0px;
}

/* Нормальное состояние */
QTreeWidget::item {
    /*padding: 5px;*/
    background-color: transparent;
    color: @text-item;
}

/* Hover */
QTreeWidget::item:hover {
    background-color: @bg-hover;
    color: @text-light;
}

/* СИСТЕМНОЕ выделение АКТИВНОЕ (есть фокус) */
QTreeWidget::item:selected:active {
    background-color: @accent;
    color: @text-light;
}

/* СИСТЕМНОЕ выделение НЕАКТИВНОЕ (потерян фокус) — ТОТ ЖЕ ЦВET */
QTreeWidget::item:selected:!active {
    background-color: @accent;
}

/* Программное выделение (текущая книга) — приоритет */
QTreeWidget::item[playing="true"] {
    background-color: @accent !important;
    color: @text-light !important;
}


/* ============================================================
   СЛАЙДЕРЫ
   ============================================================ */

QSlider::groove:horizontal {
    background: @border;
    height: 10px;
}

QSlider::handle:horizontal {
    background: @accent;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border: 2px solid @bg-dark;
}

QSlider::handle:horizontal:hover {
    background: @accent-hover;
}

QSlider::handle:horizontal:pressed {
    background: @accent-pressed;
}

QSlider::sub-page:horizontal {
    background-color: @accent;
}

QSlider::add-page:horizontal {
    background: @border;
}

QSlider#speedSlider::sub-page:horizontal {
    background-color: @border;
}

/* ============================================================
   ПРОГРЕСС-БАРЫ
   ============================================================ */

QProgressBar {
    background-color: @bg-dark;
    border: 1px solid @border;
    border-radius: 3px;
    text-align: center;
    color: @text-light;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: @accent;
}

#scanProgressBar {
    height: 25px;
    font-size: 13px;
}

#scanConsole {
    background-color: @bg-console;
    color: @text-console;
    font-family: Consolas, monospace;
    font-size: 11px;
    border: 1px solid @bg-main;
}

#scanStatusLabel {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 5px;
}

/* ============================================================
   МЕТКИ (LABELS)
   ============================================================ */

QLabel {
    color: @text-main;
}

QLabel#titleLabel {
    font-size: 18px;
    font-weight: bold;
    color: @text-light;
}

QLabel#subtitleLabel {
    font-size: 14px;
    color: @text-meta;
}

QLabel#timeLabel {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px;
    color: @text-meta;
}

QLabel#bigTimeLabel {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 15px;
    font-weight: bold;
    color: @accent;
}

QLabel#statusOk {
    color: @status-ok;
    font-weight: bold;
}

QLabel#statusError {
    color: @status-error;
    font-weight: bold;
}

QLabel#statusWarning {
    color: @status-warning;
    font-weight: bold;
}

QLabel#sectionLabel {
    font-weight: bold;
    color: @text-light;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ============================================================
   СКРОЛЛБАРЫ
   ============================================================ */

/* Вертикальный скроллбар */
QScrollBar:vertical {
    background-color: @bg-main;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: @border;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: @accent;
}

QScrollBar::handle:vertical:pressed {
    background-color: @accent-hover;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* Горизонтальный скроллбар */
QScrollBar:horizontal {
    background-color: @bg-main;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: @border;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @accent;
}

QScrollBar::handle:horizontal:pressed {
    background-color: @accent-hover;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============================================================
   ФРЕЙМЫ
   ============================================================ */

QFrame {
    border: none;
}

QFrame#separator {
    background-color: @border;
    max-height: 2px;
    min-height: 2px;
}

/* ============================================================
   МЕНЮ
   ============================================================ */
/* Цвет верхней панели (меню-бар) */
QMenuBar {
    background-color: @bg-dark;  /* основной фон панели */
    color: @text-main;             /* цвет текста пунктов меню */
    font-size: 13px;
}

QMenu {
    background-color: @bg-dark;
    border: 1px solid @bg-main;
    padding: 2px;
    margin: 3px;
}

QMenu::item {
    padding: 2px 2px;
    color: @text-main;

}

QMenu::item:selected {
    background-color: @accent;
    color: @text-light;

}

QMenu::item:pressed {
    background-color: @accent-pressed;

}

QMenu::separator {
    height: 1px;
    background-color: @border;
    margin: 5px 10px;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

/* ============================================================
   ОКНО НАСТРОЕК
   ============================================================ */
/* Фон диалогового окна */
QDialog {
    background-color: @bg-main;  /* тёмно-серый фон */
    color: @text-main;             /* цвет текста внутри диалога */
}

/* Фон всего виджета вкладок */
QTabWidget {
    background-color: @bg-dark; /* фон контента вкладки */
}

/* Вкладки сверху */
QTabBar {
    background-color: @bg-darker; /* фон полоски с вкладками */
}

QTabBar::tab {
    background-color: @bg-main;  /* фон вкладки */
    color: @text-main;             /* цвет текста */
    padding: 8px 20px;
    border: 1px solid @border;  /* рамка вокруг вкладки */
    border-bottom: none;         /* чтобы была "связанная" с контентом */
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    margin-right: 2px;
}

/* Вкладка при наведении мыши */
QTabBar::tab:hover {
    background-color: @accent;
    color: @text-light;
}

/* Активная вкладка */
QTabBar::tab:selected {
    background-color: @accent;
    color: @text-light;
    border-bottom: 1px solid @accent; /* чтобы визуально сливалась с контентом */
}

/* Вкладки слева/справа/снизу — если используешь */
QTabBar::tab:!selected {
    margin-top: 2px;  /* отделяем неактивные от активной */
}

/* ========================================
   ДЕЛЕГАТ АУДИОКНИГИ - СТИЛИЗАЦИЯ СТРОК
   ======================================== */

/* Автор книги */
QLabel#delegate_author {
    font-size: 14px;
    color: @text-delegate;
}

/* Название книги */
QLabel#delegate_title {
    font-size: 14px;
    font-weight: bold;
    color: @text-delegate;
}

/* Рассказчик */
QLabel#delegate_narrator {
    font-size: 14px;
    color: @text-delegate;
}

/* Общая информация */
QLabel#delegate_info {
    font-size: 14px;
    font-weight: bold;
    color: @text-delegate;
}

/* Папка */
QLabel#delegate_folder {
    font-size: 14px;
    font-weight: bold;
    color: @text-delegate;
}

/* Прогресс прослушивания */
QLabel#delegate_progress {
    font-size: 12px;
    font-weight: bold;
    color: @text-delegate;
}

/* Длительность */
QLabel#delegate_duration {
    font-size: 12px;
    font-weight: bold;
    color: @text-delegate;
}

/* Количество файлов */
QLabel#delegate_file_count {
    font-size: 12px;
    font-weight: bold;
    color: @text-delegate;
}

/* ============================================================
   TOOLTIP (всплывающие подсказки)
   ============================================================ */

QToolTip {
    color: @text-main;              /* цвет текста */
    border: 1px solid @accent;  /* рамка */
    padding: 3px;
}

/* ============================================================
   TREE
   ============================================================ */

/* Рамка миниатюры */
#thumbnail_border {
    border: 1px solid @border-item;
}

/* Фон прогресс-бара */
#progress_bar_bg {
    background-color: @bg-progress;
    min-height: 5px;
    max-height: 5px;
}

/* Заполнение прогресс-бара */
#progress_bar_fill {
    background-color: @progress-fill;
}

/* Активная точка индикатора */
#dot_active {
    background-color: @text-light;
    min-width: 6px;
    max-width: 6px;
    min-height: 6px;
    max-height: 6px;
}

/* Неактивная точка индикатора */
#dot_inactive {
    background-color: @color-inactive;
}

/* Фон пустой миниатюры */
#empty_thumbnail_bg {
    background-color: @border-item;
}

/* Рамка пустой миниатюры */
#empty_thumbnail_border {
    border: 1px solid @border-muted;
}

/* Иконка пустой миниатюры */
#empty_thumbnail_icon {
    color: @color-inactive;
    font-family: Arial;
    font-size: 16pt;
}

/* Фон метки длительности */
#duration_label_bg {
    background-color: @bg-overlay;
}

/* Текст метки длительности */
#duration_label_text {
    color: white;
    font-size: 9pt;
}

/* Название видео */
#video_title {
    color: white;
    font-size: 12px;
    font-weight: bold;
}

/* Информация о видео */
#video_info {
    color: @text-info;
    font-size: 12px;
}

/* Текст прогресса просмотра */
#video_progress_text {
    color: @progress-fill;
    font-size: 12px;
    /*font-style: italic;*/
}

/* ============================================================
   QComboBox в стиле кнопок
   ============================================================ */

QComboBox {
    background-color: @bg-dark;
    color: @text-main;
    border: 1px solid @border;
    padding: 5px;
    min-height: 16px;
    font-weight: 500;
}

QComboBox:hover {
    background-color: @accent;
    border-color: @accent;
}

QComboBox:focus {
    border-color: @accent;
}

/* убираем зону стрелки */
QComboBox::drop-down {
    width: 0px;
    border: none;
}

/* Выпадающий список */
QComboBox QAbstractItemView {
    background-color: @bg-dark;
}



/* ============================================================
   GROUP BOX
   ============================================================ */

QGroupBox {
    background-color: transparent;
    border: 1px solid @border;
    border-radius: 5px;
    margin-top: 15px; /* Leave space for the title */
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 3px;
    background-color: @bg-main; /* Should match the dialog background */
    color: @text-main;
}

/* ============================================================
   FOLDER STATS DIALOG
   ============================================================ */

QDialog#FolderStatsDialog {
    background-color: @bg-main;
}

#FolderStatsDialog QLabel {
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Cards/Containers */
#FolderStatsDialog QFrame {
    background-color: @bg-dark;
    border-radius: 5px;
}

/* Specific Labels */
#FolderStatsDialog QLabel#StatsTitle {
    font-size: 18px; 
    font-weight: bold; 
    color: @text-light;
}

#FolderStatsDialog QLabel#StatsSubtitle {
    font-size: 13px; 
    color: @text-meta;
}

#FolderStatsDialog QLabel#StatsLabel {
    font-size: 13px; 
    color: @text-meta;
}

#FolderStatsDialog QLabel#StatsValue {
    font-size: 13px; 
    font-weight: bold; 
    color: @text-main;
}

/* Legend */
#FolderStatsDialog QLabel#LegendLabel {
    color: @text-meta; 
    font-size: 11px;
}

/* Progress Bar */
#FolderStatsDialog QProgressBar#FolderStatsProgressBar {
    border: none;
    background-color: @bg-main;
    border-radius: 5px;
    text-align: center;
}

#FolderStatsDialog QProgressBar#FolderStatsProgressBar::chunk {
    background-color: @accent;
    border-radius: 5px;
}

/* Header Labels */
#FolderStatsDialog QLabel#ProgressLabel {
    font-weight: bold;
    font-size: 14px;
    color: @text-main;
}

/* Vertical Separator Line */
#FolderStatsDialog QFrame#StatsSeparator {
    background-color: @separator-color;
}

/* Legend Dot */
#FolderStatsDialog QLabel#LegendDot {
    font-size: 16px;
}

/* Status Properties for Coloring */
QLabel[status="watched"] { color: @chart-watched; }
QLabel[status="in_progress"] { color: @chart-progress; }
QLabel[status="unwatched"] { color: @chart-unwatched; }
QLabel[status="default"] { color: @text-main; }

/* Donut Chart Colors */
DonutChart {
    qproperty-watchedColor: @chart-watched;
    qproperty-inProgressColor: @chart-progress;
    qproperty-unwatchedColor: @chart-unwatched;
    qproperty-holeColor: @bg-dark;     /* Matches card background */
    qproperty-centerTextColor: @text-light;
}


/* ============================================================
   CHECKBOXES (QTreeWidget indicators)
   ============================================================ */

QTreeWidget::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #cccccc;
    border-radius: 2px;
}

QTreeWidget::indicator:checked {
    image: none;
    border: 1px solid #cccccc;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.4, fx:0.5, fy:0.5, stop:0 #cccccc, stop:0.6 #cccccc, stop:0.7 transparent);
}


QTreeWidget::indicator:unchecked {
    background-color: transparent;
}


/* ============================================================
   CHECKBOXES (QCheckBox indicators)
   ============================================================ */

QCheckBox::indicator, QListWidget::indicator, QTreeWidget::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #cccccc;
    border-radius: 2px;
}

QCheckBox::indicator:checked, QListWidget::indicator:checked, QTreeWidget::indicator:checked {
    image: none;
    border: 1px solid #cccccc;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.4, fx:0.5, fy:0.5, stop:0 #cccccc, stop:0.6 #cccccc, stop:0.7 transparent);
}

QCheckBox::indicator:unchecked, QListWidget::indicator:unchecked, QTreeWidget::indicator:unchecked {
    background-color: transparent;
}


/* ============================================================
   TAGS DIALOG
   ============================================================ */

QPushButton#TagColorBtn {
    border: 1px solid #555555;
    border-radius: 4px;
}

QLabel#TagBadge {
    padding: 3px 8px;
    border-radius: 10px;
    color: #ffffff;
    font-weight: bold;
}

/* ============================================================
   TAG FILTER POPUP
   ============================================================ */
#TagPopupFrame {
    background-color: @bg-dark;
    border: 1px solid @accent;
    border-radius: 5px;
}

#popupTagList {
    background-color: transparent;
    border: none;
}

#popupSeparator {
    background-color: @border;
    max-height: 1px;
    min-height: 1px;
}

#TagPopupFrame QPushButton {
    background-color: @bg-darker;
    border: 1px solid @border;
    font-size: 11px;
    padding: 4px;
}

#TagPopupFrame QPushButton:hover {
    background-color: @accent;
}
